# ---------------------------------------------------------------------------
# Environment variables for the Cybersecurity Portfolio
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or real secrets to Git. (.env* is git-ignored.)
# ---------------------------------------------------------------------------

# Public site URL (used for SEO canonical URLs, Open Graph, sitemap).
# Example for production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Contact form email delivery — Resend (https://resend.com)
#
# The contact API route (app/api/contact/route.ts) sends each submission as a
# real email. It only reports success when Resend confirms acceptance; if these
# vars are missing it returns an error instead of a fake "sent" message.
#
# SETUP (no custom domain required):
#   1. Create a free account at resend.com USING waji21569870@gmail.com.
#   2. Create an API key (Dashboard -> API Keys) and paste it below.
#   3. Leave CONTACT_FROM_EMAIL unset to use Resend's shared sender
#      "onboarding@resend.dev" — it delivers to your own account email
#      (waji21569870@gmail.com) with NO domain verification.
#   4. To send from your own domain later, verify it in Resend and set
#      CONTACT_FROM_EMAIL to an address on that verified domain.
#
# These are SERVER-ONLY (no NEXT_PUBLIC_ prefix) — never exposed to the browser.
# ---------------------------------------------------------------------------

# Required to enable real delivery:
RESEND_API_KEY=your_resend_api_key_here

# Destination inbox (defaults to the email in lib/data.ts if omitted):
CONTACT_EMAIL=waji21569870@gmail.com

# Optional — only set once you have a verified domain in Resend:
# CONTACT_FROM_EMAIL=Portfolio Contact <contact@your-verified-domain.com>
